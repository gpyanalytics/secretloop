node_modules/
out/
*.vsix
.vscode-test/
.DS_Store
**/.DS_Store

# Python bytecode from bench/. Absent until 0.1.1, which is how three .pyc
# files got committed: `npm run bench` writes bench/__pycache__/, a later
# `git add -A` swept it in, and nothing here said no. They shipped nowhere --
# .npmignore is an allowlist and .vscodeignore excludes bench/** -- but they
# made every bench run dirty the working tree.
__pycache__/
*.pyc

# Benchmark output that must never be committed. PRIVATE-FINDINGS.md records
# possible-real credentials found while measuring the false-positive rate on
# other people's repositories, for responsible disclosure by a human. It is
# ignored rather than absent so the file has one known name and one known place.
PRIVATE-FINDINGS.md
